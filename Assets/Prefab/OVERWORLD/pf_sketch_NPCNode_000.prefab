--- !u!114 &1273010003583304767
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7344221689874196979}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7744c4835a508a64c9e18699d63a2c96, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  calculateAdjacentNodes: 1
  graphNodes: []
  characterName: Harder Quiz NPC
  choiceDialogue:
  - _speakingCharacter: 
    _dialogueText: Hello. I am an NPC that will test your knowledge!
    _speakingSFX: {fileID: 0}
    choiceOptions: []
    NonImpactingChoice: 0
  - _speakingCharacter: 
    _dialogueText: I will ask you a question, and you must select the right answer!
      Are you ready?
    _speakingSFX: {fileID: 0}
    choiceOptions: []
    NonImpactingChoice: 0
  - _speakingCharacter: 
    _dialogueText: This time, you only have once chance. Are you ready?
    _speakingSFX: {fileID: 0}
    choiceOptions: []
    NonImpactingChoice: 0
  - _speakingCharacter: 
    _dialogueText: 'What is 294 X 34? Hint: Multiply the last digits of each number!'
    _speakingSFX: {fileID: 0}
    choiceOptions:
    - <ChoiceText>k__BackingField: 9997
      <CorrectAnswer>k__BackingField: 0
      <ResultingDialogue>k__BackingField:
      - _speakingCharacter: 
        _dialogueText: Uh oh... unfortunately that was the wrong answer.
        _speakingSFX: {fileID: 0}
      - _speakingCharacter: 
        _dialogueText: Thai is the result of 768 X 13 however, so you were close
          somewhat!
        _speakingSFX: {fileID: 0}
    - <ChoiceText>k__BackingField: 8192
      <CorrectAnswer>k__BackingField: 0
      <ResultingDialogue>k__BackingField:
      - _speakingCharacter: 
        _dialogueText: Ooh... not quite unfortunately!
        _speakingSFX: {fileID: 0}
      - _speakingCharacter: 
        _dialogueText: But that is quite a nice number. That represents 2 multiplied
          by itself 13 times!
        _speakingSFX: {fileID: 0}
    - <ChoiceText>k__BackingField: 9996
      <CorrectAnswer>k__BackingField: 1
      <ResultingDialogue>k__BackingField:
      - _speakingCharacter: 
        _dialogueText: Corect answer!
        _speakingSFX: {fileID: 0}
      - _speakingCharacter: 
        _dialogueText: Good job! This number is the closest number to 10 000 that
          has the highest number of factors!
        _speakingSFX: {fileID: 0}
    NonImpactingChoice: 0
  savableChoice:
    <ChoiceID>k__BackingField: 
    <SelectedChoice>k__BackingField: 0
    <TimeTakenToSelect>k__BackingField: 0
    <CorrectAnswer>k__BackingField: 0
  resultantDialogueObjects: []
  onlyOneChance: 1
  rewardItem: {fileID: 11400000, guid: c63f0e63b3501974782093e1747dfccf, type: 2}
