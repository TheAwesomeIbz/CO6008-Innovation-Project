  characterName: 
  choiceDialogue:
  - _speakingCharacter: 
    _dialogueText: The fundamental theorem of algebra states that all polynomial
      of degree N will have N roots that exist within the real or complex plane.
    _speakingSFX: {fileID: 0}
    choiceOptions: []
    NonImpactingChoice: 0
  - _speakingCharacter: 
    _dialogueText: "How many roots does [f(x) = x\xB3 - 2x + 3] have?"
    _speakingSFX: {fileID: 0}
    choiceOptions:
    - <ChoiceText>k__BackingField: 3
      <CorrectAnswer>k__BackingField: 1
      <ResultingDialogue>k__BackingField:
      - _speakingCharacter: 
        _dialogueText: Congratulations, that is the correct answer.
        _speakingSFX: {fileID: 0}
      - _speakingCharacter: 
        _dialogueText: Because the highest power or degree in the polynomial is 3,
          this equation will have 3 solutions or roots.
        _speakingSFX: {fileID: 0}
    - <ChoiceText>k__BackingField: 4
      <CorrectAnswer>k__BackingField: 0
      <ResultingDialogue>k__BackingField:
      - _speakingCharacter: 
        _dialogueText: Unfortunately that was not the correct answer.
        _speakingSFX: {fileID: 0}
    - <ChoiceText>k__BackingField: Infinite Amount
      <CorrectAnswer>k__BackingField: 0
      <ResultingDialogue>k__BackingField:
      - _speakingCharacter: 
        _dialogueText: Unfortunately that was not the correct answer.
        _speakingSFX: {fileID: 0}
    NonImpactingChoice: 0
  savableChoice:
    <ChoiceID>k__BackingField: npc0
    <SelectedChoice>k__BackingField: 0
    <TimeTakenToSelect>k__BackingField: 0
    <CorrectAnswer>k__BackingField: 0
