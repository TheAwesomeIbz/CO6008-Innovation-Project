      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: choiceDialogue.Array.data[0]._dialogueText
      value: "Using the cubic discriminant formula, evaluate the nature of the roots
        of the following equation f(x) = x\xB3 \u2013 69x + 420."
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: resultantDialogueObjects.Array.data[0]._dialogueText
      value: "For a standard cubic in the form f(x) = ax\xB3 + bx\xB2 + cx + d, the
        formula, \u0394 = b2c2 \u2212 4ac3 \u2212 4b3d \u2212 27a2d2 + 18abcd, determines
        the nature of the roots."
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: choiceDialogue.Array.data[0].choiceOptions.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: choiceDialogue.Array.data[0].choiceOptions.Array.data[0].<ChoiceText>k__BackingField
      value: 'All the three roots are real and distinct. '
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: choiceDialogue.Array.data[0].choiceOptions.Array.data[1].<ChoiceText>k__BackingField
      value: 'Two of its roots are complex numbers and the third root is real. '
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: choiceDialogue.Array.data[0].choiceOptions.Array.data[2].<ChoiceText>k__BackingField
      value: 'All the three roots are real where at least two of them are equal. '
      objectReference: {fileID: 0}
    - target: {fileID: 1273010003583304767, guid: 879de548f71de604e8cc6018966bd7bd, type: 3}
      propertyPath: choiceDialogue.Array.data[0].choiceOptions.Array.data[1].<CorrectAnswer>k__BackingField
