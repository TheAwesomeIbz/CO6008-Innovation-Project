--- !u!1001 &1722454352
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 3657750595127706157, guid: 83f67faf358644b34ad60e68c9dc8f56, type: 3}
      propertyPath: dialogueObjects.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3657750595127706157, guid: 83f67faf358644b34ad60e68c9dc8f56, type: 3}
      propertyPath: dialogueObjects.Array.data[0]._dialogueText
      value: Hi there <NAME>!
      objectReference: {fileID: 0}
    - target: {fileID: 3657750595127706157, guid: 83f67faf358644b34ad60e68c9dc8f56, type: 3}
      propertyPath: dialogueObjects.Array.data[1]._dialogueText
      value: What are these "polynomial monsters" you ask?
      objectReference: {fileID: 0}
    - target: {fileID: 3657750595127706157, guid: 83f67faf358644b34ad60e68c9dc8f56, type: 3}
      propertyPath: dialogueObjects.Array.data[2]._dialogueText
      value: 'A polynomial is a mathematical expression made up of terms that are
        combined using addition, subtraction, and multiplication. '
      objectReference: {fileID: 0}
    - target: {fileID: 3657750595127706157, guid: 83f67faf358644b34ad60e68c9dc8f56, type: 3}
      propertyPath: dialogueObjects.Array.data[3]._dialogueText
      value: Each term consists of a variable (like x or y) raised to a non-negative
