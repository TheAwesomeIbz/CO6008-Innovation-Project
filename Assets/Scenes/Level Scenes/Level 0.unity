  m_Name: 
  m_EditorClassIdentifier: 
  NPCName: 
  dialogueObjects:
  - _speakingCharacter: 
    _dialogueText: Hi there <NAME>!
    _speakingSFX: {fileID: 0}
  - _speakingCharacter: 
    _dialogueText: What are these "polynomial monsters" you ask?
    _speakingSFX: {fileID: 0}
  - _speakingCharacter: 
    _dialogueText: 'A polynomial is a mathematical expression made up of terms that
      are combined using addition, subtraction, and multiplication. '
    _speakingSFX: {fileID: 0}
  - _speakingCharacter: 
    _dialogueText: Each term consists of a variable (like x or y) raised to a non-negative
      integer power, multiplied by a coefficient (a number).
    _speakingSFX: {fileID: 0}
